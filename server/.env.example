# Environment variables for local development
# Copy this to .env and fill in your values

# Database - PostgreSQL connection string
# For local dev, you can use SQLite by setting USE_SQLITE=true
DATABASE_URL=postgresql://user:password@localhost:5432/ab_testing

# For local development only - uses SQLite instead of PostgreSQL
USE_SQLITE=true

# Server port
PORT=3000

# CORS - comma-separated list of allowed origins
# Use * for development, set to your actual domain in production
CORS_ORIGIN=*
